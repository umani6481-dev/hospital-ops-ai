# ----- Database -----
DATABASE_URL=sqlite:///./hospital_ops.db
# For Docker/Postgres:
# DATABASE_URL=postgresql://hop_user:hop_password@localhost:5432/hospital_ops

# ----- Security -----
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# ----- Redis (optional, for future Celery background workers) -----
